        </div>
        <div class="flex flex-col gap-2">
          <span class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface mb-1">Solutions</span>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/solutions">Infrastructure</a>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/solutions#ai">Intelligence</a>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/solutions#networking">Security</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface mb-1">Connect</span>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/contact">Stockholm HQ</a>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/insights">Insights</a>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/contact">Contact</a>
        </div>
      </div>
    </div>
    <div class="pt-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">© 2024 Visbyr Nordic Functionalism. All rights reserved.</p>
      <div class="flex gap-6">
        <a class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors" href="/legal">Legal</a>
        <a class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors" href="/privacy">Privacy</a>
      </div>
    </div>
