          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/solutions#ai">Intelligence</a>
          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/solutions#networking">Security</a>
        </div>
        <div class="flex flex-col gap-sm">
          <span class="mono-label font-bold mb-sm">Connect</span>
          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/contact">Stockholm HQ</a>
          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/insights">Insights</a>
