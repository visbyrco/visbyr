<footer class="w-full bg-surface-container-low border-t border-outline-variant dark:border-white/[0.08]">
  <div class="max-w-[56rem] mx-auto px-4 md:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8 border-b border-outline-variant/30 dark:border-white/[0.06]">
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-sm">
          <img src="/visbyr-wide-logo.png" alt="Visbyr" class="h-7 w-auto" />
        </div>
        <p class="font-body text-body-sm text-on-surface-variant max-w-xs leading-relaxed">
          Stockholm's leading enterprise technology partner. Built for scale, designed for clarity.
        </p>
        <div class="flex gap-3 opacity-40">
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors ease-spring">language</span>
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors ease-spring">alternate_email</span>
        </div>
      </div>
      <div class="md:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col gap-2">
          <span class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface mb-1">Studio</span>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/philosophy">Philosophy</a>
          <a class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant hover:text-primary transition-colors ease-spring" href="/process">Process</a>
