      <p class="mono-label text-on-surface-variant text-[10px]">© 2024 Visbyr Nordic Functionalism. All rights reserved.</p>
      <div class="flex gap-lg">
        <a class="mono-label text-[10px] text-on-surface-variant hover:text-primary" href="/legal">Legal</a>
        <a class="mono-label text-[10px] text-on-surface-variant hover:text-primary" href="/privacy">Privacy</a>
