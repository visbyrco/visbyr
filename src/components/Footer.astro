<footer class="w-full py-xxl bg-white border-t border-outline-variant/30">
  <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-xl pb-xxl border-b border-outline-variant/10">
      <div class="md:col-span-5 space-y-lg">
        <div class="flex items-center gap-sm">
          <img src="/visbyr-wide-logo.png" alt="Visbyr Wide Logo" class="h-8 w-auto" />
        </div>
        <p class="text-on-surface-variant body-text max-w-xs">
          Stockholm's leading enterprise technology partner. Built for scale, designed for clarity.
        </p>
        <div class="flex gap-md opacity-40">
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors">language</span>
          <span class="material-symbols-outlined cursor-pointer hover:text-primary transition-colors">alternate_email</span>
