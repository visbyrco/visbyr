          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/philosophy">Philosophy</a>
          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/process">Process</a>
          <a class="mono-label text-on-surface-variant hover:text-primary transition-colors" href="/careers">Careers</a>
