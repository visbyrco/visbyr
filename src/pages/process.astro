---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaSection from '../components/CtaSection.astro';
---

<BaseLayout title="Process | Visbyr" description="How Visbyr works: a short audit, careful integration, then ongoing care. Three passes, 2–12 weeks each.">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader
      n="02"
      label="Process"
      title="Three passes, no surprises"
      lede="A short audit, careful integration, then we stay around to keep it healthy. Every engagement follows the same shape."
    />

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <div class="border-t border-hairline">
          {[
            {
              n: '01',
              title: 'Audit & discovery',
              dur: '2–4 weeks',
              body: 'We begin by mapping what you already have: every integration point, the data flows, where time actually goes. You get a map and a short list of what to fix first — not a 40-page deck.',
              deliverables: 'Architecture map · Performance baseline · Roadmap',
            },
            {
              n: '02',
              title: 'Modular integration',
              dur: '4–12 weeks',
              body: 'We ship one module at a time, behind feature flags. Each piece is built, tested, and validated on its own before it touches the broader system, so nothing goes down.',
              deliverables: 'Deployed modules · Integration test suite · Documentation',
            },
            {
              n: '03',
              title: 'Optimization & scale',
              dur: 'Ongoing',
              body: 'We watch latency and cost so small issues do not become outages. Quarterly reviews and a private channel keep the system healthy as your organization grows.',
              deliverables: 'Performance dashboards · Quarterly reviews · 24/7 channel',
            },
          ].map((p) => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-10 py-10 border-b border-hairline">
              <div class="md:col-span-4">
                <p class="font-mono text-[12px] tracking-[0.08em] text-accent mb-3">{p.n}</p>
                <h2 class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.03em] leading-tight">{p.title}</h2>
                <p class="mt-3 text-[14px] text-muted">{p.dur}</p>
              </div>
              <div class="md:col-span-8 space-y-5">
                <p class="text-[16px] leading-relaxed text-muted max-w-[38rem]">{p.body}</p>
                <p class="text-[14px] text-ink"><span class="text-faint">Deliverables — </span>{p.deliverables}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-10 py-10">
          <div class="md:border-l border-hairline pl-5"><p class="text-[26px] font-semibold tracking-[-0.02em] leading-none">98%</p><p class="mt-2 text-[14px] text-muted">client retention</p></div>
          <div class="md:border-l border-hairline pl-5"><p class="text-[26px] font-semibold tracking-[-0.02em] leading-none">42%</p><p class="mt-2 text-[14px] text-muted">average cost reduction</p></div>
          <div class="md:border-l border-hairline pl-5"><p class="text-[26px] font-semibold tracking-[-0.02em] leading-none">0 min</p><p class="mt-2 text-[14px] text-muted">downtime during integration</p></div>
        </div>
      </div>
    </section>

    <CtaSection title="Start with pass 01" body="Book a discovery session. We look at your stack, then tell you honestly whether the Visbyr method fits." cta="Book a call" />
  </main>
  <SiteFooter />
</BaseLayout>
