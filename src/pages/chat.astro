---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ArrowRight from '../components/ArrowRight.astro';
---

<BaseLayout title="Visbyr Chat — One chat, every model" description="Multi-provider AI chat. Bring your own keys from OpenAI, Anthropic, Google, xAI, or any OpenAI-compatible endpoint.">
  <SiteHeader />
  <main class="pt-16">
    <!-- Hero -->
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-12 md:py-20">
        <div class="grid-12 gap-8 md:gap-12">
          <div class="col-span-12 lg:col-span-7 flex flex-col justify-center">
            <p class="eyebrow mb-6">Visbyr Chat — live at chat.visbyr.com</p>
            <h1 class="text-[clamp(2.5rem,6vw,4.25rem)] font-semibold leading-[1.0] tracking-[-0.03em] mb-7">
              One chat.<br />
              <em class="not-italic italic text-accent">Every model.</em>
            </h1>
            <p class="text-[17px] leading-relaxed text-muted max-w-[34rem] mb-9">
              Visbyr Chat is a multi-provider AI chat that does not lock you in. Bring your own keys from OpenAI, Anthropic, Google, xAI, or any OpenAI-compatible endpoint, pick the best model for the job, and switch mid-conversation without losing context.
            </p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-6 border-t border-hairline">
              <a href="https://chat.visbyr.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-accent text-on-accent px-5 py-2.5 text-[13px] font-medium rounded-[3px] hover:bg-accent-strong transition-colors">
                Open chat.visbyr.com <ArrowUpRight />
              </a>
              <a href="#how-it-works" class="inline-flex items-center gap-2 text-[14px] text-muted hover:text-ink transition-colors">
                How it works <ArrowRight />
              </a>
            </div>
            <p class="mt-6 font-mono text-[12px] tracking-[0.02em] text-faint">Encrypted keys · resumable streams · your data stays yours</p>
          </div>

          <!-- App preview — mirrors the real chat UI: left rail, teal user pill, plain assistant text, rounded composer -->
          <div class="col-span-12 lg:col-span-5">
            <div class="border border-hairline bg-card overflow-hidden">
              <div class="flex">
                <!-- Left rail -->
                <div class="w-11 shrink-0 border-r border-hairline flex flex-col items-center py-2.5 gap-2.5">
                  <svg viewBox="0 0 32 32" width="18" height="18" class="shrink-0 text-faint" role="img" aria-label="Visbyr">
                    <rect x="2" y="2" width="28" height="28" rx="6" fill="currentColor" opacity="0.1" />
                    <path d="M9 11 L16 22 L23 11 H19.2 L16 17.4 L12.8 11 Z" fill="currentColor" />
                  </svg>
                  <span class="w-7 h-7 bg-accent text-on-accent flex items-center justify-center rounded-md" title="New chat">
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 13l1-3.5L11.5 2 14 4.5 6.5 12 3 13z" /></svg>
                  </span>
                  <span class="mt-auto text-faint" title="Settings">
                    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="2" /><path d="M8 1.8v2M8 12.2v2M1.8 8h2M12.2 8h2M3.6 3.6l1.4 1.4M11 11l1.4 1.4M12.4 3.6 11 5M5 11l-1.4 1.4" /></svg>
                  </span>
                </div>
                <!-- Conversation + composer -->
                <div class="flex-1 min-w-0 p-3.5 flex flex-col">
                  <div class="space-y-3 flex-1">
                    <div class="flex justify-end">
                      <div class="max-w-[85%] bg-accent text-on-accent px-3.5 py-2 text-[13px] leading-snug rounded-xl">
                        Compare Claude 4.5 and GPT-5 for this codebase?
                      </div>
                    </div>
                    <div class="flex gap-2.5">
                      <span class="w-6 h-6 rounded-full bg-wash border border-hairline flex items-center justify-center shrink-0 mt-0.5">
                        <svg viewBox="0 0 16 16" width="10" height="10" fill="currentColor" class="text-accent" aria-hidden="true"><path d="M8 1.5l1.3 3.7L13 6.5l-3.7 1.3L8 11.5 6.7 7.8 3 6.5l3.7-1.3L8 1.5zM12.5 10l.6 1.7 1.7.6-1.7.6-.6 1.7-.6-1.7-1.7-.6 1.7-.6.6-1.7z" /></svg>
                      </span>
                      <p class="text-[13px] leading-relaxed text-ink min-w-0">Claude 4.5 Sonnet — it is stronger on large refactors. Want me to scan the repo and propose a plan for the diff?</p>
                    </div>
                  </div>
                  <!-- Composer -->
                  <div class="mt-5 rounded-2xl border border-hairline bg-background p-2.5">
                    <p class="px-1.5 pb-2 text-[13px] text-faint truncate">Ask anything…</p>
                    <div class="flex items-center gap-1.5 px-0.5">
                      <span class="w-7 h-7 border border-hairline rounded-md flex items-center justify-center text-faint" title="Attach files">
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M11.5 4.5 5.9 10.1a1.8 1.8 0 0 0 2.5 2.5l5.6-5.6a3.6 3.6 0 0 0-5.1-5.1L3.3 7.5a5.3 5.3 0 0 0 7.5 7.5" /></svg>
                      </span>
                      <span class="inline-flex items-center gap-1.5 border border-hairline rounded-md px-2 py-1.5 text-[12px] text-muted" title="Tools">
                        <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M9.5 5.5a3 3 0 0 1 3.7-3.7l-2 2 .8 1.6 1.6.8 2-2a3 3 0 0 1-3.7 3.7L7 12.8a1.6 1.6 0 0 1-2.3-2.3l4.8-5z" /></svg>
                        Tools
                      </span>
                      <span class="ml-auto inline-flex items-center gap-1.5 border border-hairline rounded-md px-2 py-1.5 text-[12px] text-muted" title="Model">
                        <span class="w-2 h-2 rounded-sm bg-[#7000ff]" aria-hidden="true"></span> GPT-5
                      </span>
                      <span class="w-7 h-7 bg-accent text-on-accent flex items-center justify-center rounded-full shrink-0" title="Send">
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" stroke-linecap="square" /></svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <p class="mt-4 text-center lg:text-left font-mono text-[11px] tracking-[0.02em] text-faint">Works with OpenAI · Anthropic · Google · xAI · any OpenAI-compatible endpoint</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow n="01" label="Why Visbyr Chat" />
        <div class="grid grid-cols-1 md:grid-cols-3 border-t border-hairline mt-8">
          <div class="py-8 md:pr-10 border-b md:border-b-0 md:border-r border-hairline">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Keys stay encrypted</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-4">Add any provider with an encrypted API key. No proxy, no markup. Your key decrypts only when your request runs.</p>
            <p class="font-mono text-[11px] tracking-[0.04em] text-faint">AES-GCM · ENCRYPTION_KEY</p>
          </div>
          <div class="py-8 md:px-10 border-b md:border-b-0 md:border-r border-hairline">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Switch models mid-chat</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-4">Start on a fast model, switch to a reasoning model when it gets hard. The model selector follows your conversation, not the other way around.</p>
            <p class="font-mono text-[11px] tracking-[0.04em] text-faint">Model catalog · live sync</p>
          </div>
          <div class="py-8 md:pl-10">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Streams that survive reloads</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-4">Close the tab, lose Wi-Fi, come back. The stream resumes through Redis so you do not lose a long answer halfway through.</p>
            <p class="font-mono text-[11px] tracking-[0.04em] text-faint">resumable-stream · Redis</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What you get -->
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow n="02" label="What you get" />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 border-t border-hairline mt-8">
          {[
            ['Tools that actually do things', 'Web search, URL fetch, document write and edit, writing suggestions, and Python execution with Pyodide. All behind one model catalog.'],
            ['Artifacts on the side', 'Code, text, sheets, and images live in a panel next to the chat. Edit with versioning, not by pasting back and forth.'],
            ['Reasoning control', 'Pick effort per message — none, minimal, low, medium, high, max — and see it reflected in the model badge.'],
            ['Real rich-text editing', 'Documents use ProseMirror, not a textarea. Code artifacts use CodeMirror with Shiki highlighting.'],
            ['Mobile that keeps up', 'Custom keyboard handling, swipe actions, and a sidebar that becomes a sheet. It feels like an app, not a shrunken desktop.'],
            ['Export and extras', 'Export chats to markdown, slash commands, custom themes, private chats, file attachments, and image paste.'],
          ].map(([t, d]) => (
            <div class="py-6 lg:py-8 border-b border-hairline">
              <h3 class="text-[16px] font-semibold mb-2">{t}</h3>
              <p class="text-[15px] leading-relaxed text-muted">{d}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-x-8 border-t border-hairline">
          {[
            ['Stack', 'Next.js 16 · React 19 · AI SDK 7'],
            ['Auth', 'Clerk · private by default'],
            ['Data', 'Postgres · Drizzle ORM'],
            ['Cache', 'Redis · rate limit + resume'],
          ].map(([k, v]) => (
            <div class="py-5 border-b border-hairline">
              <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint mb-1.5">{k}</p>
              <p class="font-mono text-[12px] text-ink">{v}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Artifacts / Tools -->
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 md:gap-12">
          <div>
            <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint mb-5">Artifacts</p>
            <h3 class="text-[clamp(1.5rem,2.6vw,2rem)] font-semibold leading-[1.1] tracking-[-0.03em] mb-4">Code and writing live next to the chat, not inside it</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-7 max-w-[34rem]">
              When the model writes something worth keeping, it opens in a panel on the right. You read and edit there while the conversation stays readable on the left. Every change versions, so you can step back.
            </p>
            <div class="border border-hairline bg-[#141819]">
              <div class="flex items-center justify-between px-4 py-2 border-b border-white/10">
                <span class="font-mono text-[11px] text-white/50">artifact.ts</span>
                <span class="font-mono text-[10px] tracking-[0.08em] uppercase text-white/30">v3 · copy</span>
              </div>
              <pre class="font-mono text-[12px] leading-relaxed text-white/75 p-4 overflow-x-auto"><code>writeDocument(&#123; kind: "code", title: "parse-csv.ts" &#125;)
  // streams into the panel
  // you edit, it versions</code></pre>
            </div>
          </div>
          <div>
            <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint mb-5">Tools</p>
            <h3 class="text-[clamp(1.5rem,2.6vw,2rem)] font-semibold leading-[1.1] tracking-[-0.03em] mb-4">The model can search, fetch, calculate, and write files</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-7 max-w-[34rem]">
              Tools are not demos. Web search and URL fetch for grounding, Python for real compute, and document tools that target edits with find-and-replace.
            </p>
            <div class="border-t border-hairline">
              {[
                ['search-web', 'ground answers'],
                ['fetch-url', 'read any page'],
                ['run-python', 'Pyodide in browser'],
                ['write / edit-document', 'versioned'],
              ].map(([cmd, note]) => (
                <div class="flex items-center justify-between gap-4 py-3 border-b border-hairline">
                  <span class="font-mono text-[12px] text-ink">{cmd}</span>
                  <span class="text-[13px] text-faint">{note}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow n="03" label="How it works" />
        <div class="grid-12 gap-8 md:gap-12 mt-8">
          <div class="col-span-12 lg:col-span-4">
            <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.05] tracking-[-0.03em]">Three steps.<br />No sales call.</h2>
            <p class="mt-5 font-mono text-[11px] tracking-[0.04em] text-faint">chat.visbyr.com — auth required</p>
          </div>
          <div class="col-span-12 lg:col-span-8 border-t border-hairline">
            <div class="py-8 border-b border-hairline flex gap-6 md:gap-10">
              <span class="font-mono text-[12px] tracking-[0.08em] text-accent shrink-0 mt-1.5">01</span>
              <div>
                <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-2.5">Sign in and add a provider</h3>
                <p class="text-[15px] leading-relaxed text-muted max-w-[34rem]">After sign-in, open Settings and add a provider. Paste an API key from OpenAI, Anthropic, Google, or xAI — or point a custom provider at any OpenAI-compatible base URL. Keys are encrypted with your <span class="font-mono text-[13px]">ENCRYPTION_KEY</span>.</p>
              </div>
            </div>
            <div class="py-8 border-b border-hairline flex gap-6 md:gap-10">
              <span class="font-mono text-[12px] tracking-[0.08em] text-accent shrink-0 mt-1.5">02</span>
              <div>
                <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-2.5">Pick a model, set how hard it should think</h3>
                <p class="text-[15px] leading-relaxed text-muted max-w-[34rem]">The catalog shows what each model can do — tools, vision, reasoning — and how much thinking it supports. Choose per message; the badge in the composer tells you what is active.</p>
              </div>
            </div>
            <div class="py-8 flex gap-6 md:gap-10">
              <span class="font-mono text-[12px] tracking-[0.08em] text-accent shrink-0 mt-1.5">03</span>
              <div>
                <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-2.5">Chat, build, export</h3>
                <p class="text-[15px] leading-relaxed text-muted max-w-[34rem]">Chat with streaming markdown, reasoning blocks, and code blocks with copy. When the model builds an artifact, refine it in place. When you are done, export the thread to markdown — or run <span class="font-mono text-[13px]">DEMO_MODE=1</span> locally if you just want to look around.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- For whom + CTA -->
    <section>
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 border-t border-hairline mb-14">
          <div class="py-6 md:py-8 md:pr-10 border-b md:border-b-0 md:border-r border-hairline">
            <h3 class="text-[16px] font-semibold mb-2">Researchers</h3>
            <p class="text-[15px] leading-relaxed text-muted">Keep one place for every provider. Switch to the cheapest model for skimming, the strongest for synthesis.</p>
          </div>
          <div class="py-6 md:py-8 md:px-10 border-b md:border-b-0 md:border-r border-hairline">
            <h3 class="text-[16px] font-semibold mb-2">Developers</h3>
            <p class="text-[15px] leading-relaxed text-muted">Artifacts keep code out of the scroll. Python runs in the browser. No context blown on pasted files.</p>
          </div>
          <div class="py-6 md:py-8 md:pl-10">
            <h3 class="text-[16px] font-semibold mb-2">Teams that own their keys</h3>
            <p class="text-[15px] leading-relaxed text-muted">Self-host with Docker Compose, Postgres, and Redis. Or run the demo with no external services at all.</p>
          </div>
        </div>

        <div class="border-t border-hairline pt-10 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
          <div class="max-w-[34rem]">
            <h2 class="text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.03em]">
              Start chatting at <a href="https://chat.visbyr.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline underline-offset-4">chat.visbyr.com</a>
            </h2>
            <p class="mt-4 text-[16px] leading-relaxed text-muted">Sign in, add a provider, pick a model. For a quick look without keys, run locally with <span class="font-mono text-[13px]">DEMO_MODE=1 pnpm dev:demo</span>.</p>
          </div>
          <div class="flex items-center gap-5 shrink-0">
            <a href="https://chat.visbyr.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-accent text-on-accent px-6 py-3 text-[13px] font-medium rounded-[3px] hover:bg-accent-strong transition-colors">Open Visbyr Chat</a>
            <span class="font-mono text-[11px] tracking-[0.02em] text-faint">Apache 2.0 · self-hostable</span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
