---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderReact from '../components/HeaderReact.tsx';
import Footer from '../components/Footer.astro';
import SurgicalAccent from '../components/SurgicalAccent.astro';
---

<BaseLayout title="Careers | Visbyr">
  <HeaderReact client:load />
  <main class="pt-20">
    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-white border-b border-outline-variant/30">
      <div class="max-w-max-width mx-auto">
        <div class="flex items-center gap-md mb-lg">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          <span class="mono-label text-on-surface-variant">Join the Studio</span>
        </div>
        <h1 class="text-[clamp(3.5rem,10vw,6rem)] font-extrabold mb-xl leading-none max-w-4xl">
          Build the <span class="text-primary">future</span> with us.
        </h1>
        <p class="text-lg text-on-surface-variant max-w-2xl body-text">
          We are a collective of engineers, designers, and strategists united by a shared commitment to Nordic functionalism. If you believe technology should be purposeful, precise, and enduring — you belong here.
        </p>
      </div>
    </section>

    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-white">
      <div class="max-w-max-width mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-xxl gap-lg">
          <div class="max-w-2xl">
            <SurgicalAccent />
            <h2 class="text-5xl font-bold mb-lg mt-lg">Open Positions</h2>
            <p class="text-xl text-on-surface-variant body-text">Current opportunities at our Stockholm studio.</p>
          </div>
          <div class="mono-label text-primary font-bold">[ 01 — Roles ]</div>
        </div>

        <div class="border-t border-outline-variant/30">
          <div class="p-xl border-b border-outline-variant/30 hover:bg-surface-container-low transition-colors group">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-lg">
              <div>
                <div class="flex items-center gap-md mb-sm">
                  <span class="mono-label text-primary bg-primary-fixed px-3 py-1">Engineering</span>
                  <span class="mono-label text-on-surface-variant">Stockholm</span>
                </div>
                <h3 class="text-2xl font-bold group-hover:text-primary transition-colors">Senior Cloud Infrastructure Engineer</h3>
                <p class="body-text text-on-surface-variant mt-sm max-w-xl">Design and implement scalable cloud architectures for enterprise clients across the Nordic region.</p>
              </div>
              <a href="/contact" class="mono-label font-bold text-primary flex items-center gap-sm hover:gap-md transition-all shrink-0">
                Apply <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>

          <div class="p-xl border-b border-outline-variant/30 hover:bg-surface-container-low transition-colors group">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-lg">
              <div>
                <div class="flex items-center gap-md mb-sm">
                  <span class="mono-label text-primary bg-primary-fixed px-3 py-1">AI / ML</span>
                  <span class="mono-label text-on-surface-variant">Stockholm</span>
                </div>
                <h3 class="text-2xl font-bold group-hover:text-primary transition-colors">Machine Learning Researcher</h3>
                <p class="body-text text-on-surface-variant mt-sm max-w-xl">Develop predictive models and neural architectures for industrial IoT and enterprise analytics.</p>
              </div>
              <a href="/contact" class="mono-label font-bold text-primary flex items-center gap-sm hover:gap-md transition-all shrink-0">
                Apply <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>

          <div class="p-xl border-b border-outline-variant/30 hover:bg-surface-container-low transition-colors group">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-lg">
              <div>
                <div class="flex items-center gap-md mb-sm">
                  <span class="mono-label text-primary bg-primary-fixed px-3 py-1">Security</span>
                  <span class="mono-label text-on-surface-variant">Stockholm / Remote</span>
                </div>
                <h3 class="text-2xl font-bold group-hover:text-primary transition-colors">Zero-Trust Security Architect</h3>
                <p class="body-text text-on-surface-variant mt-sm max-w-xl">Architect end-to-end encrypted systems and hardware-level authentication frameworks for distributed enterprises.</p>
              </div>
              <a href="/contact" class="mono-label font-bold text-primary flex items-center gap-sm hover:gap-md transition-all shrink-0">
                Apply <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>

          <div class="p-xl hover:bg-surface-container-low transition-colors group">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-lg">
              <div>
                <div class="flex items-center gap-md mb-sm">
                  <span class="mono-label text-primary bg-primary-fixed px-3 py-1">Design</span>
                  <span class="mono-label text-on-surface-variant">Stockholm</span>
                </div>
                <h3 class="text-2xl font-bold group-hover:text-primary transition-colors">Enterprise UX Designer</h3>
                <p class="body-text text-on-surface-variant mt-sm max-w-xl">Craft intuitive interfaces for complex enterprise systems. Nordic functionalism experience preferred.</p>
              </div>
              <a href="/contact" class="mono-label font-bold text-primary flex items-center gap-sm hover:gap-md transition-all shrink-0">
                Apply <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-surface border-y border-outline-variant/30">
      <div class="max-w-max-width mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-xxl gap-lg">
          <div class="max-w-2xl">
            <h2 class="text-4xl font-bold mb-lg">Why Visbyr</h2>
          </div>
          <div class="mono-label text-primary font-bold">[ 02 — Benefits ]</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
          <div class="p-xl bg-white border border-outline-variant/30">
            <span class="material-symbols-outlined text-primary mb-lg block text-3xl">workspace_premium</span>
            <h4 class="text-xl font-bold mb-md">Ownership & Autonomy</h4>
            <p class="font-sans text-on-surface-variant">Full project ownership from audit to deployment. No micromanagement — just trust and accountability.</p>
          </div>
          <div class="p-xl bg-white border border-outline-variant/30">
            <span class="material-symbols-outlined text-primary mb-lg block text-3xl">self_improvement</span>
            <h4 class="text-xl font-bold mb-md">Continuous Learning</h4>
            <p class="font-sans text-on-surface-variant">Dedicated research time, conference budgets, and access to our proprietary training programs.</p>
          </div>
          <div class="p-xl bg-white border border-outline-variant/30">
            <span class="material-symbols-outlined text-primary mb-lg block text-3xl">balance</span>
            <h4 class="text-xl font-bold mb-md">Nordic Work-Life Balance</h4>
            <p class="font-sans text-on-surface-variant">Flexible hours, generous parental leave, and a culture that respects personal time.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-white border-y border-outline-variant/30">
      <div class="max-w-max-width mx-auto text-center">
        <h2 class="text-[clamp(2.5rem,8vw,5rem)] font-extrabold mb-lg leading-none">Don't see your role?</h2>
        <p class="text-xl text-on-surface-variant body-text mb-xl max-w-2xl mx-auto">We are always interested in exceptional talent. Send us your portfolio and let's explore possibilities.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-xl">
          <a href="/contact" class="bg-primary text-white px-xxl py-4 mono-label font-bold hover:brightness-110 transition-all inline-block text-center">
            Get in Touch
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
