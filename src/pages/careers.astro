---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaSection from '../components/CtaSection.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ArrowRight from '../components/ArrowRight.astro';
---

<BaseLayout title="Careers | Visbyr" description="Open positions at the Visbyr studio in Stockholm. Cloud, ML, security, and design.">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader
      n="05"
      label="Careers"
      title="Small team, high trust"
      lede="We are eight engineers and designers in Stockholm who believe technology should be purposeful, precise, and enduring. You would own projects from audit to deployment."
    />

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Open positions" />
        <div class="border-t border-hairline mt-8">
          {[
            { tag: 'Engineering', loc: 'Stockholm', title: 'Senior Cloud Infrastructure Engineer', desc: 'Design and run cloud architectures for enterprise clients across the Nordic region.' },
            { tag: 'AI / ML', loc: 'Stockholm', title: 'Machine Learning Engineer', desc: 'Build predictive models for industrial IoT and enterprise analytics.' },
            { tag: 'Security', loc: 'Stockholm / Remote', title: 'Zero-Trust Security Architect', desc: 'Design encrypted systems and hardware-key authentication for distributed enterprises.' },
            { tag: 'Design', loc: 'Stockholm', title: 'Product Designer', desc: 'Design interfaces for complex systems. Restraint is the house style.' },
          ].map((r) => (
            <div class="group flex flex-col md:flex-row md:items-center justify-between gap-4 py-7 border-b border-hairline">
              <div>
                <div class="flex items-baseline gap-3 mb-1.5">
                  <span class="font-mono text-[11px] tracking-[0.08em] uppercase text-accent">{r.tag}</span>
                  <span class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint">{r.loc}</span>
                </div>
                <h3 class="text-[19px] font-semibold tracking-[-0.02em] group-hover:text-accent transition-colors">{r.title}</h3>
                <p class="text-[15px] text-muted mt-1 max-w-[36rem]">{r.desc}</p>
              </div>
              <a href="/contact" class="inline-flex items-center gap-2 text-[14px] text-accent shrink-0 hover:text-ink transition-colors">
                Apply <ArrowRight class="transition-transform group-hover:translate-x-0.5" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Why Visbyr" />
        <div class="grid grid-cols-1 md:grid-cols-3 border-t border-hairline mt-8">
          <div class="py-8 md:pr-10 border-b md:border-b-0 md:border-r border-hairline">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Ownership</h3>
            <p class="text-[15px] leading-relaxed text-muted">Full project ownership from audit to deployment. No micromanagement — trust and accountability instead.</p>
          </div>
          <div class="py-8 md:px-10 border-b md:border-b-0 md:border-r border-hairline">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Learning</h3>
            <p class="text-[15px] leading-relaxed text-muted">Dedicated research time, a conference budget, and colleagues who will read your draft twice.</p>
          </div>
          <div class="py-8 md:pl-10">
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Balance</h3>
            <p class="text-[15px] leading-relaxed text-muted">Flexible hours, generous parental leave, and a culture that respects personal time. Work ends at 17:00 more often than not.</p>
          </div>
        </div>
      </div>
    </section>

    <CtaSection title="Don't see your role?" body="We are always interested in strong people. Send us your portfolio and we will read it — all of it, ourselves." cta="Get in touch" />
  </main>
  <SiteFooter />
</BaseLayout>
