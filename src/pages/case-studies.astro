---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderReact from '../components/HeaderReact.tsx';
import Footer from '../components/Footer.astro';
import SurgicalAccent from '../components/SurgicalAccent.astro';
---

<BaseLayout title="Case Studies | Visbyr">
  <HeaderReact client:load />
  <main class="pt-20">
    <section class="py-12 md:py-20 px-4 md:px-6 bg-surface-container-lowest dark:bg-background border-b border-outline-variant dark:border-white/[0.08]">
      <div class="max-w-[56rem] mx-auto">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-primary dark:bg-cyber-cyan"></span>
          <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Proven Results</span>
        </div>
        <h1 class="font-display text-[clamp(2.5rem,8vw,4rem)] font-bold leading-none tracking-[-0.015em] mb-4 max-w-3xl">
          Case <span class="text-primary dark:text-cyber-cyan">Studies.</span>
        </h1>
        <p class="font-body text-body-base text-on-surface-variant max-w-2xl leading-relaxed">
          Real outcomes from real engagements. See how Nordic enterprises have transformed their operations through Visbyr's precision-engineered solutions.
        </p>
      </div>
    </section>

    <section class="py-12 md:py-20 px-4 md:px-6 bg-surface dark:bg-background">
      <div class="max-w-[56rem] mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-10 gap-6">
          <div class="max-w-2xl">
            <SurgicalAccent />
            <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em] mt-4 mb-3">Client Engagements</h2>
            <p class="font-body text-body-base text-on-surface-variant">Selected projects demonstrating measurable impact across industries.</p>
          </div>
          <div class="font-label text-[12px] tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan">[ 01 — Portfolio ]</div>
        </div>

        <div class="space-y-6 border-t border-outline-variant dark:border-white/[0.08] pt-6">
          <article class="group glass-mid rounded-xl p-6 flex flex-col md:flex-row gap-6 items-start hover:shadow-ambient-sm transition-all ease-spring">
            <div class="w-full md:w-1/3">
              <div class="relative aspect-video overflow-hidden rounded-lg border border-outline-variant dark:border-white/[0.08]">
                <img class="w-full h-full object-cover grayscale brightness-90 group-hover:grayscale-0 transition-all duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBNRY01VD2n53xWxyUnPTDo-J84OrNCLTcAmCBWlGVuwvIbNhsA7KdA0FcoM7WPyXcJ9Z7KzKpe-yXt3W7jEStN1SpugELHo4if0mm0mLtvoiwLQCRaAJxhXc7qdNlc8_SMnJMDmdYNiFEUOFXy3X9dAX-zr5qSCU4ah0VPN5fvJ0Nr77Q0_eTx1cXBPq8NigD01g9zifrSTrVQB5JiQjr4BZVJJnxwBv33ovnt3lD-daA6NJj72yuj" alt="Svea Logistics Hub" />
                <div class="absolute top-2 left-2 font-label text-[10px] tracking-[0.02em] uppercase bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-2 py-0.5 rounded-full">Cloud</div>
              </div>
            </div>
            <div class="w-full md:w-2/3 space-y-4">
              <div class="flex items-center gap-2">
                <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Svea Logistics Hub</span>
                <span class="font-label text-[12px] text-on-surface-variant">—</span>
                <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Logistics</span>
              </div>
              <h3 class="font-display text-xl md:text-2xl font-semibold group-hover:text-primary dark:group-hover:text-cyber-cyan transition-colors">Automated Cloud Migration for National Logistics Network</h3>
              <p class="font-body text-body-sm text-on-surface-variant leading-relaxed">Migrated a legacy on-premise logistics platform to a hybrid cloud architecture, implementing auto-scaling clusters and edge-native delivery across 14 Nordic distribution centers.</p>
              <div class="grid grid-cols-3 gap-4 pt-4 border-t border-outline-variant dark:border-white/[0.08]">
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">42%</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Cost Reduction</p></div>
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">99.97%</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Uptime Achieved</p></div>
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">8wk</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Migration Time</p></div>
              </div>
            </div>
          </article>

          <article class="group glass-mid rounded-xl p-6 flex flex-col md:flex-row gap-6 items-start hover:shadow-ambient-sm transition-all ease-spring">
            <div class="w-full md:w-1/3">
              <div class="relative aspect-video overflow-hidden rounded-lg border border-outline-variant dark:border-white/[0.08] bg-surface-container dark:bg-white/[0.03] flex items-center justify-center">
                <span class="material-symbols-outlined text-on-surface-variant text-6xl">analytics</span>
                <div class="absolute top-2 left-2 font-label text-[10px] tracking-[0.02em] uppercase bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-2 py-0.5 rounded-full">AI</div>
              </div>
            </div>
            <div class="w-full md:w-2/3 space-y-4">
              <div class="flex items-center gap-2">
                <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Svea Dynamics</span>
                <span class="font-label text-[12px] text-on-surface-variant">—</span>
                <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Manufacturing</span>
              </div>
              <h3 class="font-display text-xl md:text-2xl font-semibold group-hover:text-primary dark:group-hover:text-cyber-cyan transition-colors">AI-Driven Predictive Maintenance for Industrial Fleet</h3>
              <p class="font-body text-body-sm text-on-surface-variant leading-relaxed">Deployed proprietary machine learning models to monitor 2,400+ industrial IoT sensors in real-time, achieving 89% accuracy in equipment failure prediction and reducing unplanned downtime by 67%.</p>
              <div class="grid grid-cols-3 gap-4 pt-4 border-t border-outline-variant dark:border-white/[0.08]">
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">89%</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Prediction Accuracy</p></div>
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">67%</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Downtime Reduced</p></div>
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">2.4K</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Sensors Monitored</p></div>
              </div>
            </div>
          </article>

          <article class="group glass-mid rounded-xl p-6 flex flex-col md:flex-row gap-6 items-start hover:shadow-ambient-sm transition-all ease-spring">
            <div class="w-full md:w-1/3">
              <div class="relative aspect-video overflow-hidden rounded-lg border border-outline-variant dark:border-white/[0.08] bg-surface-container dark:bg-white/[0.03] flex items-center justify-center">
                <span class="material-symbols-outlined text-on-surface-variant text-6xl">verified_user</span>
                <div class="absolute top-2 left-2 font-label text-[10px] tracking-[0.02em] uppercase bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-2 py-0.5 rounded-full">Security</div>
              </div>
            </div>
            <div class="w-full md:w-2/3 space-y-4">
              <div class="flex items-center gap-2">
                <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Norrköping Financial Group</span>
                <span class="font-label text-[12px] text-on-surface-variant">—</span>
                <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Finance</span>
              </div>
              <h3 class="font-display text-xl md:text-2xl font-semibold group-hover:text-primary dark:group-hover:text-cyber-cyan transition-colors">Zero-Trust Network Overhaul for Regional Bank</h3>
              <p class="font-body text-body-sm text-on-surface-variant leading-relaxed">Implemented end-to-end encrypted tunnels and hardware-level authentication across 32 branch offices, achieving full zero-trust compliance within a single quarter.</p>
              <div class="grid grid-cols-3 gap-4 pt-4 border-t border-outline-variant dark:border-white/[0.08]">
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">&lt;1ms</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Auth Latency</p></div>
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">32</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Branches Secured</p></div>
                <div><p class="font-display text-2xl font-bold text-primary dark:text-cyber-cyan">0</p><p class="font-label text-[10px] tracking-[0.02em] uppercase text-on-surface-variant">Security Incidents</p></div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16 px-4 md:px-6 bg-inverse-surface dark:bg-surface-container-lowest text-inverse-on-surface dark:text-mist-text rounded-xl mx-4 md:mx-auto max-w-[56rem] mb-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em] mb-3">Ready to be our next success story?</h2>
      <p class="font-body text-body-base opacity-80 mb-6 max-w-xl mx-auto">Let's discuss how Visbyr can engineer a solution tailored to your organization's unique challenges.</p>
      <a href="/contact" class="inline-block rounded-full bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-6 py-3 font-label text-[12px] tracking-[0.02em] uppercase hover:shadow-bloom transition-all ease-spring">Start a Project</a>
    </section>
  </main>
  <Footer />
</BaseLayout>
