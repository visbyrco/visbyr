---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowRight from '../components/ArrowRight.astro';
---

<BaseLayout title="Case studies | Visbyr" description="Three recent Visbyr engagements: cloud migration, predictive maintenance, zero-trust networking.">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader
      n="03"
      label="Case studies"
      title="Numbers from finished work"
      lede="Three recent engagements. The figures come from the projects themselves, not from projections."
    />

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Selected work" />
        <div class="border-t border-hairline mt-8">
          {[
            {
              client: 'Svea Logistics Hub', industry: 'Logistics',
              title: 'Automated cloud migration for a national logistics network',
              body: 'Migrated a legacy on-premise logistics platform to a hybrid cloud architecture, with auto-scaling clusters and edge-native delivery across 14 Nordic distribution centers.',
              stats: [['42%', 'cost reduction'], ['99.97%', 'uptime'], ['8 wk', 'migration']],
              img: 'https://images.unsplash.com/photo-1553413077-190dd305871c?w=800&q=80&auto=format&fit=crop',
              alt: 'Warehouse aisle, racking in perspective',
            },
            {
              client: 'Svea Dynamics', industry: 'Manufacturing',
              title: 'Predictive maintenance for an industrial fleet',
              body: 'Machine learning models monitoring 2,400 industrial IoT sensors in real time, predicting equipment failures days ahead and cutting unplanned downtime by two thirds.',
              stats: [['89%', 'prediction accuracy'], ['67%', 'downtime reduced'], ['2.4K', 'sensors monitored']],
              img: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&q=80&auto=format&fit=crop',
              alt: 'Monitoring dashboard with live charts',
            },
            {
              client: 'Norrköping Financial Group', industry: 'Finance',
              title: 'Zero-trust network overhaul for a regional bank',
              body: 'End-to-end encrypted tunnels and hardware-key authentication across 32 branch offices, with full zero-trust compliance reached within a single quarter.',
              stats: [['<1ms', 'auth latency'], ['32', 'branches secured'], ['0', 'security incidents']],
              img: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=800&q=80&auto=format&fit=crop',
              alt: 'Server room, structured cabling',
            },
          ].map((c) => (
            <article class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 py-10 border-b border-hairline items-start">
              <div class="md:col-span-3">
                <div class="aspect-[4/3] overflow-hidden border border-hairline bg-wash">
                  <img class="w-full h-full object-cover grayscale" src={c.img} alt={c.alt} loading="lazy" />
                </div>
              </div>
              <div class="md:col-span-9">
                <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint mb-2">{c.client} · {c.industry}</p>
                <h2 class="text-[clamp(1.35rem,2.6vw,1.875rem)] font-semibold tracking-[-0.025em] leading-tight max-w-[28ch] mb-3">{c.title}</h2>
                <p class="text-[15px] leading-relaxed text-muted max-w-[42rem] mb-6">{c.body}</p>
                <div class="flex flex-wrap gap-x-10 gap-y-3 pt-4 border-t border-hairline">
                  {c.stats.map(([v, l]) => (
                    <div class="flex items-baseline gap-2.5">
                      <span class="text-[20px] font-semibold tracking-[-0.02em]">{v}</span>
                      <span class="text-[13px] text-muted">{l}</span>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CtaSection title="Want numbers like these?" body="It starts with an audit. Book a 45-minute call and we will tell you what we would measure first." cta="Book a call" />
  </main>
  <SiteFooter />
</BaseLayout>
