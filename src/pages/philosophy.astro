---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaSection from '../components/CtaSection.astro';
---

<BaseLayout title="Philosophy | Visbyr" description="Nordic functionalism applied to software: purposeful, restrained, enduring.">
  <SiteHeader />
  <main class="pt-16">
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 pt-32 md:pt-40 pb-12 md:pb-16">
        <div class="grid-12 gap-8 md:gap-12">
          <div class="col-span-12 lg:col-span-8">
            <div class="flex items-baseline gap-3 mb-6">
              <span class="font-mono text-[11px] tracking-[0.08em] text-faint">06</span>
              <span class="eyebrow">Philosophy</span>
            </div>
            <h1 class="text-[clamp(2.5rem,6vw,4.25rem)] font-semibold leading-[1.0] tracking-[-0.03em] mb-7">
              Nordic<br />
              <em class="not-italic italic font-normal text-accent">functionalism</em><br />
              in code
            </h1>
            <p class="max-w-[30rem] text-[17px] leading-relaxed text-muted pt-6 border-t border-hairline">
              We believe technology should serve clarity. Every system we build is guided by the principles of Nordic design — purposeful, restrained, and enduring.
            </p>
          </div>
          <div class="col-span-12 lg:col-span-4">
            <figure>
              <div class="aspect-[4/5] overflow-hidden border border-hairline bg-wash">
                <img class="w-full h-full object-cover grayscale" src="https://images.unsplash.com/photo-1487958449943-2429e8be8625?w=900&q=80&auto=format&fit=crop" alt="White modern architecture against a clear sky" loading="eager" />
              </div>
              <figcaption class="pt-3 font-mono text-[11px] tracking-[0.04em] uppercase text-faint">Form follows the work it does</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Principles" />
        <div class="grid grid-cols-1 md:grid-cols-2 border-t border-hairline mt-8">
          {[
            ['Precision', 'Every line of code is deliberate. We reject bloat, ambiguity, and unnecessary complexity. Systems do exactly what they claim — nothing more, nothing less.'],
            ['Clarity', 'Interfaces should communicate, not confuse. We reduce the distance between intent and response so the system explains itself.'],
            ['Sovereignty', 'Data belongs to its creators. We architect for Nordic data governance, and clients keep full control of their assets.'],
            ['Sustainability', 'Efficient code is green code. We optimize for minimal resource consumption so systems scale without expanding their footprint.'],
          ].map(([t, d], i) => (
            <div class={`py-8 ${i % 2 === 0 ? 'md:pr-10' : 'md:pl-10 md:border-l'} border-b ${i >= 2 ? 'md:border-t md:border-b-0' : ''} border-hairline`}>
              <p class="font-mono text-[11px] tracking-[0.08em] text-faint mb-4">0{i + 1}</p>
              <h2 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">{t}</h2>
              <p class="text-[15px] leading-relaxed text-muted">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#1a1e1f] text-[#e6eaeb] dark:bg-wash dark:text-ink border-b border-hairline">
      <div class="max-w-[42rem] mx-auto px-5 md:px-8 py-16 md:py-24">
        <p class="text-[clamp(1.5rem,2.6vw,2rem)] font-normal leading-[1.4] tracking-[-0.015em]">
          “Good technology disappears. It should feel so natural that the user forgets it exists — and that is when the design has worked.”
        </p>
        <p class="mt-8 font-mono text-[11px] tracking-[0.08em] uppercase text-[#9aa5a5] dark:text-muted">Visbyr design notes · Stockholm, 2024</p>
      </div>
    </section>

    <CtaSection title="Come argue with us" body="If you think technology should be purposeful too, we should talk. We are always looking for partners who push back well." cta="Start a conversation" />
  </main>
  <SiteFooter />
</BaseLayout>
