---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Legal | Visbyr">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader label="Legal" title="Terms of service" lede="Last updated October 2026." />

    <section class="border-t border-hairline">
      <div class="max-w-[42rem] mx-auto px-5 md:px-8 py-14 md:py-20">
        {[
          ['1', 'Who we are', 'Visbyr is a two-person software studio run by Vilhelm Gain and Timothy Wong. Our product is Visbyr Chat at chat.visbyr.com.'],
          ['2', 'What we offer', 'We build software products. Visbyr Chat is our only product right now, and more is coming.'],
          ['3', 'Intellectual property', 'Our code, designs, and writing belong to us unless we agree otherwise in writing.'],
          ['4', 'Contact', 'Questions about these terms? Reach us through the contact page.'],
        ].map(([n, t, p]) => (
          <div class="py-8 border-b border-hairline first:pt-0">
            <h2 class="text-[19px] font-semibold tracking-[-0.02em] mb-3"><span class="font-mono text-[12px] text-faint mr-3">{n}</span>{t}</h2>
            <p class="text-[15px] leading-relaxed text-muted">{p}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
