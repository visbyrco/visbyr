---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderReact from '../components/HeaderReact.tsx';
import Footer from '../components/Footer.astro';
import SurgicalAccent from '../components/SurgicalAccent.astro';
---

<BaseLayout title="Visbyr | Nordic Tech Innovation">
  <HeaderReact client:load />
  <main class="pt-20">
    <!-- Hero -->
    <section class="relative py-12 md:py-20 px-4 md:px-6 overflow-hidden border-b border-outline-variant dark:border-white/[0.08]">
      <div class="max-w-[56rem] mx-auto">
        <div class="asymmetric-grid gap-y-8">
          <div class="col-span-12 lg:col-span-8 flex flex-col justify-end pt-8 md:pt-16 order-2 lg:order-1">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-2 h-2 rounded-full bg-primary dark:bg-cyber-cyan"></span>
              <span class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant">Swedish Precision</span>
            </div>
            <h1 class="font-display text-[clamp(2.5rem,8vw,4.5rem)] font-bold leading-[0.95] tracking-[-0.015em] mb-8">
              The Future of <br />
              <span class="text-primary dark:text-cyber-cyan italic font-light">Nordic Tech</span> <br />
              Innovation
            </h1>
            <div class="flex flex-col md:flex-row gap-8 md:items-start border-t border-outline-variant dark:border-white/[0.08] pt-6">
              <p class="max-w-md font-body text-body-base text-on-surface-variant leading-relaxed">
                Streamlining complex workflows with surgical precision. We build the digital backbone for the world's most ambitious enterprises from our Stockholm studio.
              </p>
              <div class="flex flex-col gap-2">
                <a href="/solutions" class="text-left font-label text-[12px] font-semibold tracking-[0.02em] uppercase group flex items-center gap-2 py-2 border-b border-transparent hover:border-primary dark:hover:border-cyber-cyan transition-all ease-spring">
                  Explore Solutions <span class="material-symbols-outlined text-sm">north_east</span>
                </a>
                <a href="/case-studies" class="text-left font-label text-[12px] font-semibold tracking-[0.02em] uppercase group flex items-center gap-2 py-2 border-b border-transparent hover:border-primary dark:hover:border-cyber-cyan transition-all ease-spring">
                  View Case Studies <span class="material-symbols-outlined text-sm">north_east</span>
                </a>
              </div>
            </div>
          </div>
          <div class="col-span-12 lg:col-span-4 order-1 lg:order-2 flex justify-end">
            <div class="relative w-full aspect-[4/5] lg:w-[360px] rounded-xl border border-outline-variant dark:border-white/[0.08] p-2 glass-mid dark:glass-mid overflow-visible">
              <img
                class="w-full h-full object-cover grayscale brightness-105 rounded-lg"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC23p5x0HlZapnFJd9HSAMfT4hRvRtyDc97SvMOOuPB-Z16xwCU1EHYDpM0S3jJOFlA4ajK5-fQ9cF6zw5nRjSjaVAyAW9X6SqNBWCnk34bOhGqsZnGe9dh5r3XJfCTS0OmEhGkKNJpyvAbVB0lyu2DhFRQJbnEO6SvyWVNAs6KMGdx2TYvgQsxvBHZYmxEK7v0YRuu6KS--WV4rh7gX7tl3AByMydT-ZDBS0FIJlZsnueFRRSZG9Iw"
                alt="Minimalist Stockholm architectural office"
              />
              <div class="absolute -top-3 -right-3 font-label text-[12px] font-semibold tracking-[0.02em] uppercase bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-3 py-1 rounded-full shadow-bloom">Est. 2024</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trusted Partners -->
    <section class="bg-surface-container-lowest dark:bg-surface-container-low py-8 px-4 md:px-6 border-b border-outline-variant dark:border-white/[0.08]">
      <div class="max-w-[56rem] mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
        <span class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant opacity-60">Trusted Partners</span>
        <div class="flex flex-wrap justify-center items-center gap-8 opacity-20 grayscale scale-90">
          <div class="h-3 w-20 bg-on-surface rounded-sm"></div>
          <div class="h-3 w-28 bg-on-surface rounded-sm"></div>
          <div class="h-3 w-24 bg-on-surface rounded-sm"></div>
          <div class="h-3 w-32 bg-on-surface rounded-sm"></div>
        </div>
      </div>
    </section>

    <!-- Engineered Solutions -->
    <section class="py-12 md:py-20 px-4 md:px-6 bg-surface dark:bg-background">
      <div class="max-w-[56rem] mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-10 gap-6">
          <div class="max-w-2xl">
            <SurgicalAccent />
            <h2 class="font-display text-display-lg md:text-[32px] font-bold tracking-[-0.015em] mt-4 mb-3">Precision Engineered Systems</h2>
            <p class="font-body text-body-base text-on-surface-variant leading-relaxed">Modular integration layers designed to scale with your organization's inherent complexity. Each component operates in perfect synchronicity.</p>
          </div>
          <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan">[ 01 — Capabilities ]</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 rounded-xl overflow-hidden border border-outline-variant dark:border-white/[0.08]">
          <div class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-outline-variant dark:border-white/[0.08] group glass-mid hover:bg-surface-container-high dark:hover:bg-white/[0.04] transition-colors duration-500 ease-spring">
            <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant mb-6">Architecture.01</div>
            <h3 class="font-display text-headline-md font-semibold mb-3">Cloud Infrastructure</h3>
            <p class="font-body text-body-sm text-on-surface-variant mb-6 leading-relaxed">Scalable, low-latency infrastructure optimized for the Nordic regulatory landscape and performance requirements.</p>
            <a class="group-hover:text-primary dark:group-hover:text-cyber-cyan transition-colors ease-spring flex items-center gap-2 font-label text-[12px] font-semibold tracking-[0.02em] uppercase" href="/solutions">
              Documentation <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
          <div class="p-6 md:p-8 border-b md:border-b-0 md:border-r border-outline-variant dark:border-white/[0.08] group glass-mid hover:bg-surface-container-high dark:hover:bg-white/[0.04] transition-colors duration-500 ease-spring">
            <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant mb-6">Intelligence.02</div>
            <h3 class="font-display text-headline-md font-semibold mb-3">AI-Driven Analytics</h3>
            <p class="font-body text-body-sm text-on-surface-variant mb-6 leading-relaxed">Turn raw data into strategic foresight with our proprietary machine learning models built on local expertise.</p>
            <a class="group-hover:text-primary dark:group-hover:text-cyber-cyan transition-colors ease-spring flex items-center gap-2 font-label text-[12px] font-semibold tracking-[0.02em] uppercase" href="/solutions">
              Model Architecture <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
          <div class="p-6 md:p-8 group glass-mid hover:bg-surface-container-high dark:hover:bg-white/[0.04] transition-colors duration-500 ease-spring">
            <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-on-surface-variant mb-6">Defense.03</div>
            <h3 class="font-display text-headline-md font-semibold mb-3">Secure Networking</h3>
            <p class="font-body text-body-sm text-on-surface-variant mb-6 leading-relaxed">Zero-trust architecture ensuring your sensitive intellectual property remains impenetrable across all touchpoints.</p>
            <a class="group-hover:text-primary dark:group-hover:text-cyber-cyan transition-colors ease-spring flex items-center gap-2 font-label text-[12px] font-semibold tracking-[0.02em] uppercase" href="/solutions">
              Security Audit <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonial -->
    <section class="py-12 md:py-20 px-4 md:px-6 bg-inverse-surface dark:bg-surface-container-lowest text-inverse-on-surface dark:text-mist-text">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row gap-8 items-center">
        <div class="w-48 h-64 flex-shrink-0 rounded-xl overflow-hidden p-1 glass-mid bg-white/10 dark:bg-white/[0.06] border border-white/10">
          <img
            class="w-full h-full object-cover grayscale brightness-90 rounded-lg"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuA112QztJkpg-qQlRMqE6sATzF6Bzy4pkQOzYKj2WRvbriR3gaIsvvkKB3iu0EeqhwCHPlATQgEjHDBi9ztui-_MnuQdBYatZ0ghfCXa9kINcgN_Dv-oOVxXPIsK3nZWtMLpM2oU_Nd4sl_5Lc6ybW19E7diTv5TIFPGEpgY09dKzzlDHA6hTVBWL78ze0IAuPBza6lItSN2_zddGDC6mg7g0E95LD72TzJyD3ILfA5rmJh6eTBJ0pP"
            alt="Swedish technology executive"
          />
        </div>
        <div class="space-y-4">
          <span class="material-symbols-outlined text-cyber-cyan text-5xl">format_quote</span>
          <p class="font-display text-2xl md:text-3xl font-light italic leading-tight">
            "Visbyr didn't just provide a tool; they redefined our entire operational framework. Their commitment to <span class="text-cyber-cyan not-italic font-semibold">Nordic functionalism</span> is evident in every line of code."
          </p>
          <div>
            <p class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-white">Anders Lindström</p>
            <p class="font-label text-[12px] tracking-[0.02em] uppercase text-white/50">CTO, Svea Dynamics</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Visbyr Method -->
    <section class="py-12 md:py-20 px-4 md:px-6 bg-surface-container-lowest dark:bg-background overflow-hidden">
      <div class="max-w-[56rem] mx-auto">
        <div class="asymmetric-grid rounded-xl overflow-hidden border border-outline-variant dark:border-white/[0.08]">
          <div class="col-span-12 lg:col-span-4 p-6 lg:p-8 bg-surface-container-low dark:bg-surface-container lg:sticky lg:top-20 h-fit">
            <SurgicalAccent />
            <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em] mt-4 mb-3">The Visbyr <br />Method</h2>
            <p class="font-body text-body-base text-on-surface-variant mb-6 leading-relaxed">A measured, deliberate transition from legacy systems to digital excellence.</p>
            <div class="font-mono text-[10px] tracking-[0.1em] uppercase text-on-surface-variant opacity-40">Reference: SE-STHLM-24</div>
          </div>
          <div class="col-span-12 lg:col-span-8 border-t lg:border-t-0 lg:border-l border-outline-variant dark:border-white/[0.08] divide-y divide-outline-variant/30 dark:divide-white/[0.06]">
            <div class="p-6 lg:p-8 hover:bg-surface-container dark:hover:bg-white/[0.03] transition-colors ease-spring">
              <div class="flex flex-col md:flex-row gap-6">
                <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan shrink-0 mt-1">Phase_01</div>
                <div class="space-y-3">
                  <h4 class="font-display text-2xl md:text-3xl font-bold tracking-[-0.015em]">Audit & Discovery</h4>
                  <p class="font-body text-body-base text-on-surface-variant max-w-xl leading-relaxed">We map your current ecosystem to identify bottlenecks and latent opportunities for optimization using precision auditing tools.</p>
                  <div class="flex gap-2 pt-3">
                    <div class="w-1.5 h-1.5 rounded-full bg-primary dark:bg-cyber-cyan"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-outline-variant"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-outline-variant"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="p-6 lg:p-8 hover:bg-surface-container dark:hover:bg-white/[0.03] transition-colors ease-spring">
              <div class="flex flex-col md:flex-row gap-6">
                <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan shrink-0 mt-1">Phase_02</div>
                <div class="space-y-3">
                  <h4 class="font-display text-2xl md:text-3xl font-bold tracking-[-0.015em]">Modular Integration</h4>
                  <p class="font-body text-body-base text-on-surface-variant max-w-xl leading-relaxed">Our engineers deploy targeted solutions that integrate seamlessly with your existing stack without downtime or operational friction.</p>
                  <div class="flex gap-2 pt-3">
                    <div class="w-1.5 h-1.5 rounded-full bg-outline-variant"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-primary dark:bg-cyber-cyan"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-outline-variant"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="p-6 lg:p-8 hover:bg-surface-container dark:hover:bg-white/[0.03] transition-colors ease-spring">
              <div class="flex flex-col md:flex-row gap-6">
                <div class="font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan shrink-0 mt-1">Phase_03</div>
                <div class="space-y-3">
                  <h4 class="font-display text-2xl md:text-3xl font-bold tracking-[-0.015em]">Optimization & Scale</h4>
                  <p class="font-body text-body-base text-on-surface-variant max-w-xl leading-relaxed">Continuous monitoring and AI-assisted updates ensure your system remains at peak performance in an ever-evolving market.</p>
                  <div class="flex gap-2 pt-3">
                    <div class="w-1.5 h-1.5 rounded-full bg-outline-variant"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-outline-variant"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-primary dark:bg-cyber-cyan"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA — composer pill -->
    <section class="py-12 md:py-20 px-4 md:px-6 bg-surface-container-lowest dark:bg-surface-container-low border-y border-outline-variant dark:border-white/[0.08]">
      <div class="max-w-[56rem] mx-auto text-center">
        <div class="inline-flex font-label text-[12px] font-semibold tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan mb-6 border border-primary/20 dark:border-cyber-cyan/20 px-4 py-1.5 rounded-full glass-mid">Engagement_Protocol</div>
        <h2 class="font-display text-[clamp(2rem,6vw,3.5rem)] font-bold leading-none tracking-[-0.015em] mb-4">Ready to evolve your <br />digital landscape?</h2>
        <p class="font-body text-body-base text-on-surface-variant mb-8 max-w-2xl mx-auto leading-relaxed">Join the leading Swedish firms leveraging Visbyr to outpace the global market through Nordic engineering.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <button class="rounded-full bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-8 py-4 font-label text-[12px] font-semibold tracking-[0.02em] uppercase hover:shadow-bloom transition-all ease-spring">
            Book a Demo
          </button>
          <button class="rounded-full border border-outline-variant dark:border-white/[0.12] text-on-surface px-8 py-4 font-label text-[12px] font-semibold tracking-[0.02em] uppercase hover:bg-surface-container-high dark:hover:bg-white/[0.06] transition-all ease-spring">
            Contact Sales
          </button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
