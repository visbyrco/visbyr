---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowRight from '../components/ArrowRight.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
---

<BaseLayout title="Visbyr — Software products by two people">
  <SiteHeader />
  <main class="pt-16">
    <!-- Hero -->
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-12 md:py-20">
        <div class="max-w-[44rem]">
          <p class="eyebrow mb-6">Visbyr — software products</p>
          <h1 class="text-[clamp(2.5rem,6vw,4.25rem)] font-semibold leading-[1.0] tracking-[-0.03em] mb-7">
            Two people building<br />
            <em class="not-italic font-normal italic text-accent">software that works.</em>
          </h1>
          <p class="max-w-[32rem] text-[17px] leading-relaxed text-muted mb-10">
            Visbyr is Vilhelm Gain and Timothy Wong. We build software products. Visbyr Chat is live now, and more is coming.
          </p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-6 border-t border-hairline">
            <a href="/chat" class="inline-flex items-center gap-2 text-[14px] text-ink hover:text-accent transition-colors">
              Meet Visbyr Chat <ArrowRight />
            </a>
            <a href="/contact" class="inline-flex items-center gap-2 text-[14px] text-muted hover:text-ink transition-colors">
              Say hello <ArrowRight />
            </a>
            <a href="https://chat.visbyr.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-mono text-[12px] tracking-[0.02em] text-muted hover:text-ink transition-colors">
              chat.visbyr.com <ArrowUpRight />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Product -->
    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-24">
        <Eyebrow n="01" label="Product" />
        <div class="max-w-[36rem] mt-6 mb-12">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.05] tracking-[-0.03em]">One live product, more coming</h2>
          <p class="mt-4 text-[16px] leading-relaxed text-muted">Chat is our only product right now. We use it ourselves and keep improving it.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 border-t border-hairline">
          <a href="/chat" class="group py-8 md:pr-10 border-b md:border-b-0 md:border-r border-hairline">
            <p class="font-mono text-[11px] tracking-[0.08em] text-faint mb-5">a.</p>
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">Visbyr Chat</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-6">One chat for every model. Bring your own keys, switch models mid-conversation, keep your context.</p>
            <span class="inline-flex items-center gap-2 text-[14px] text-accent">Read more <ArrowRight class="transition-transform group-hover:translate-x-0.5" /></span>
          </a>
          <div class="py-8 md:pl-10">
            <p class="font-mono text-[11px] tracking-[0.08em] text-faint mb-5">b.</p>
            <h3 class="text-[19px] font-semibold tracking-[-0.02em] mb-3">What is next</h3>
            <p class="text-[15px] leading-relaxed text-muted mb-6">More products are coming. Small, useful, and built the same way: by the two of us, for people who use them daily.</p>
            <a href="/contact" class="inline-flex items-center gap-2 text-[14px] text-accent hover:text-ink transition-colors">Tell us what you need <ArrowRight /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- People -->
    <section id="people" class="border-b border-hairline scroll-mt-20">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-24">
        <Eyebrow n="02" label="People" />
        <div class="max-w-[36rem] mt-6 mb-12">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.05] tracking-[-0.03em]">The whole team</h2>
          <p class="mt-4 text-[16px] leading-relaxed text-muted">Two people. No office, no account managers. You talk to whoever does the work.</p>
        </div>
        <div class="border-t border-hairline">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 py-7 border-b border-hairline">
            <div>
              <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-accent mb-1.5">Founder</p>
              <h3 class="text-[19px] font-semibold tracking-[-0.02em]">Vilhelm Gain</h3>
              <p class="text-[15px] text-muted mt-1 max-w-[36rem]">Started Visbyr. Works across product and engineering.</p>
            </div>
            <a href="https://github.com/VilhelmGain" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[14px] text-accent shrink-0 hover:text-ink transition-colors">
              github.com/VilhelmGain <ArrowUpRight />
            </a>
          </div>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 py-7 border-b border-hairline">
            <div>
              <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-accent mb-1.5">Engineer</p>
              <h3 class="text-[19px] font-semibold tracking-[-0.02em]">Timothy Wong</h3>
              <p class="text-[15px] text-muted mt-1 max-w-[36rem]">Writes most of the code across our projects.</p>
            </div>
            <a href="https://github.com/timothy0509" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[14px] text-accent shrink-0 hover:text-ink transition-colors">
              github.com/timothy0509 <ArrowUpRight />
            </a>
          </div>
        </div>
      </div>
    </section>

    <CtaSection title="Say hello" body="Questions about Visbyr Chat, or an idea for what we should build next? Write to us and one of us answers." cta="Contact us" />
  </main>
  <SiteFooter />
</BaseLayout>
