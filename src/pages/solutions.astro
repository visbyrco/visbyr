---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CtaSection from '../components/CtaSection.astro';
import ArrowRight from '../components/ArrowRight.astro';
---

<BaseLayout title="Solutions | Visbyr" description="Cloud, data pipelines, and zero-trust networking. Built for teams that are tired of babysitting systems at midnight.">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader
      n="01"
      label="Solutions"
      title="Infrastructure that stays up"
      lede="Cloud, data pipelines, and zero-trust networking. Built for teams that are tired of babysitting systems at midnight."
    />

    <!-- Cloud -->
    <section id="cloud" class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Cloud" />
        <div class="grid-12 gap-8 md:gap-12 mt-8">
          <div class="col-span-12 lg:col-span-7">
            <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.08] tracking-[-0.03em] mb-5 max-w-[24ch]">Cloud architecture that holds under load</h2>
            <p class="text-[16px] leading-relaxed text-muted max-w-[36rem] mb-6">
              Hybrid and multi-cloud built around data residency rules. We migrate live systems without a maintenance window, then set auto-scaling that actually triggers when traffic arrives.
            </p>
            <ul class="space-y-2.5 text-[15px] leading-relaxed text-muted max-w-[36rem] mb-8">
              <li class="flex gap-3"><span class="font-mono text-[12px] text-accent mt-0.5 shrink-0">—</span>Auto-scaling clusters that respond to load spikes without manual intervention.</li>
              <li class="flex gap-3"><span class="font-mono text-[12px] text-accent mt-0.5 shrink-0">—</span>Edge-native delivery from compute nodes placed across Europe.</li>
              <li class="flex gap-3"><span class="font-mono text-[12px] text-accent mt-0.5 shrink-0">—</span>Nothing ships until it runs next to your current system and you trust it.</li>
            </ul>
            <a href="/contact" class="inline-flex items-center gap-2 text-[14px] text-accent hover:text-ink transition-colors">Talk to us about a migration <ArrowRight /></a>
          </div>
          <div class="col-span-12 lg:col-span-5">
            <div class="border border-hairline bg-card">
              <p class="px-5 py-3 border-b border-hairline font-mono text-[11px] tracking-[0.08em] uppercase text-faint">Case — Svea Logistics Hub</p>
              <div class="p-5">
                <p class="text-[15px] leading-relaxed text-muted">Migrated 3 warehouses off a single on-prem cluster. Automated the parts that kept breaking at 4am.</p>
                <div class="flex gap-10 mt-5 pt-5 border-t border-hairline">
                  <div><p class="text-[22px] font-semibold tracking-[-0.02em] leading-none">42%</p><p class="mt-1.5 text-[13px] text-muted">Cost reduction</p></div>
                  <div><p class="text-[22px] font-semibold tracking-[-0.02em] leading-none">11 days</p><p class="mt-1.5 text-[13px] text-muted">Migration</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Analytics -->
    <section id="ai" class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Analytics" />
        <div class="grid-12 gap-8 md:gap-12 mt-8">
          <div class="col-span-12 lg:col-span-7">
            <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.08] tracking-[-0.03em] mb-5 max-w-[24ch]">Analytics you can check yourself</h2>
            <p class="text-[16px] leading-relaxed text-muted max-w-[36rem] mb-8">
              We instrument first, then model. You see the query, the data, and the confidence interval — never a black box with a percentage on it.
            </p>
            <div class="border-t border-hairline">
              <div class="py-5 border-b border-hairline">
                <p class="text-[15px]"><span class="font-medium">Instrumentation before modeling.</span> <span class="text-muted">If the sensors are wrong, the model is wrong. We fix the data first.</span></p>
              </div>
              <div class="py-5 border-b border-hairline">
                <p class="text-[15px]"><span class="font-medium">Every number traceable.</span> <span class="text-muted">Each figure links back to the query and dataset that produced it.</span></p>
              </div>
              <div class="py-5">
                <p class="text-[15px]"><span class="font-medium">Alerts that mean something.</span> <span class="text-muted">The pipeline pages you at 3am when it matters, and stays quiet when it does not.</span></p>
              </div>
            </div>
          </div>
          <div class="col-span-12 lg:col-span-5 flex flex-col gap-6">
            <div class="border border-hairline bg-card">
              <p class="px-5 py-3 border-b border-hairline font-mono text-[11px] tracking-[0.08em] uppercase text-faint">Case — Svea Dynamics</p>
              <div class="p-5">
                <p class="text-[15px] leading-relaxed text-muted">Predictive maintenance for an industrial fleet. Failures flagged days before they happen.</p>
                <div class="flex gap-10 mt-5 pt-5 border-t border-hairline">
                  <div><p class="text-[22px] font-semibold tracking-[-0.02em] leading-none">89%</p><p class="mt-1.5 text-[13px] text-muted">Failure prediction</p></div>
                  <div><p class="text-[22px] font-semibold tracking-[-0.02em] leading-none">2,400</p><p class="mt-1.5 text-[13px] text-muted">Sensors monitored</p></div>
                </div>
              </div>
            </div>
            <div class="border border-hairline p-5 font-mono text-[12px] leading-6 text-muted bg-wash">
              <p><span class="text-accent">telemetry.ingest</span> — 2.4M events/s</p>
              <p>p95 latency 11ms → model.predict() → action.dispatch</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Networking -->
    <section id="networking" class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Networking" />
        <div class="grid-12 gap-8 md:gap-12 mt-8">
          <div class="col-span-12 lg:col-span-7">
            <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.08] tracking-[-0.03em] mb-5 max-w-[24ch]">Zero-trust networking, measured in milliseconds</h2>
            <p class="text-[16px] leading-relaxed text-muted max-w-[36rem] mb-8">
              Security is not a layer on top. End-to-end encrypted tunnels, hardware-key authentication, and audit logs a human can read.
            </p>
            <div class="flex gap-10 mb-8">
              <div><p class="font-mono text-[15px] text-accent">AES-256</p><p class="mt-1.5 text-[13px] text-muted">Encrypted tunnels</p></div>
              <div><p class="font-mono text-[15px] text-accent">&lt;1ms</p><p class="mt-1.5 text-[13px] text-muted">Auth handshake</p></div>
              <div><p class="font-mono text-[15px] text-accent">32</p><p class="mt-1.5 text-[13px] text-muted">Bank branches secured</p></div>
            </div>
            <a href="/contact" class="inline-flex items-center gap-2 text-[14px] text-accent hover:text-ink transition-colors">Ask for a security review <ArrowRight /></a>
          </div>
          <div class="col-span-12 lg:col-span-5">
            <div class="border border-hairline bg-card">
              <p class="px-5 py-3 border-b border-hairline font-mono text-[11px] tracking-[0.08em] uppercase text-faint">Case — Norrköping Financial Group</p>
              <div class="p-5">
                <p class="text-[15px] leading-relaxed text-muted">Full zero-trust rollout across 32 branch offices in one quarter. Zero security incidents since.</p>
                <div class="flex gap-10 mt-5 pt-5 border-t border-hairline">
                  <div><p class="text-[22px] font-semibold tracking-[-0.02em] leading-none">1 quarter</p><p class="mt-1.5 text-[13px] text-muted">Rollout</p></div>
                  <div><p class="text-[22px] font-semibold tracking-[-0.02em] leading-none">0</p><p class="mt-1.5 text-[13px] text-muted">Incidents</p></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaSection title="Not sure which one you need?" body="That is what the audit is for. Book a 45-minute call and we will tell you where we would start." cta="Book a call" />
  </main>
  <SiteFooter />
</BaseLayout>
