---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderReact from '../components/HeaderReact.tsx';
import Footer from '../components/Footer.astro';
import SecurityGraphic from '../components/SecurityGraphic.tsx';
---

<BaseLayout title="Visbyr | Advanced Solutions">
  <HeaderReact client:load />
  <main class="max-w-[56rem] mx-auto px-4 md:px-6 pt-28 pb-12">
    <section class="mb-12 text-center md:text-left">
      <div class="flex items-center gap-2 mb-4 justify-center md:justify-start">
        <span class="w-2 h-2 rounded-full bg-primary dark:bg-cyber-cyan"></span>
        <span class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Enterprise Solutions</span>
      </div>
      <h1 class="font-display text-[clamp(2.25rem,5vw,3.5rem)] font-bold leading-[0.95] tracking-[-0.02em] mb-4 max-w-3xl">
        Infrastructure that <span class="text-primary dark:text-cyber-cyan">stays up.</span>
      </h1>
      <p class="font-body text-[16px] leading-relaxed text-on-surface-variant max-w-2xl mb-8">
        Cloud, data pipelines, and zero-trust networking. Built for teams that are tired of babysitting systems at midnight.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8">
        <a class="group p-6 glass-mid rounded-xl hover:shadow-ambient-sm transition-all ease-spring" href="#cloud">
          <div class="w-12 h-12 bg-surface-container dark:bg-white/[0.06] rounded-lg flex items-center justify-center mb-6 group-hover:bg-primary-fixed dark:group-hover:bg-cyber-cyan/20 transition-colors">
            <span class="material-symbols-outlined text-primary dark:text-cyber-cyan">cloud_done</span>
          </div>
          <h3 class="font-display text-headline-md font-semibold mb-1">Cloud Infrastructure</h3>
          <p class="font-body text-body-sm text-on-surface-variant">Scalable, low-latency architectures designed for Nordic performance standards.</p>
        </a>
        <a class="group p-6 glass-mid rounded-xl hover:shadow-ambient-sm transition-all ease-spring" href="#ai">
          <div class="w-12 h-12 bg-surface-container dark:bg-white/[0.06] rounded-lg flex items-center justify-center mb-6 group-hover:bg-primary-fixed dark:group-hover:bg-cyber-cyan/20 transition-colors">
            <span class="material-symbols-outlined text-primary dark:text-cyber-cyan">analytics</span>
          </div>
          <h3 class="font-display text-headline-md font-semibold mb-1">AI-Driven Analytics</h3>
          <p class="font-body text-body-sm text-on-surface-variant">Transforming raw telemetry into predictive business intelligence.</p>
        </a>
        <a class="group p-6 glass-mid rounded-xl hover:shadow-ambient-sm transition-all ease-spring" href="#networking">
          <div class="w-12 h-12 bg-surface-container dark:bg-white/[0.06] rounded-lg flex items-center justify-center mb-6 group-hover:bg-primary-fixed dark:group-hover:bg-cyber-cyan/20 transition-colors">
            <span class="material-symbols-outlined text-primary dark:text-cyber-cyan">verified_user</span>
          </div>
          <h3 class="font-display text-headline-md font-semibold mb-1">Secure Networking</h3>
          <p class="font-body text-body-sm text-on-surface-variant">Zero-trust frameworks for distributed enterprise perimeters.</p>
        </a>
      </div>
    </section>

    <section class="py-12 border-t border-outline-variant dark:border-white/[0.08]" id="cloud">
      <div class="flex flex-col md:flex-row gap-8 items-center">
        <div class="w-full md:w-1/2">
          <span class="font-label text-[12px] tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan block mb-2">Cloud Systems</span>
          <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em] mb-4">High-Availability Cloud Architecture</h2>
          <p class="font-body text-body-base text-on-surface-variant mb-6 leading-relaxed">
            We deploy hybrid and multi-cloud strategies that prioritize data sovereignty and extreme uptime. Our Nordic-engineered frameworks ensure your infrastructure grows seamlessly with your demand.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary dark:text-cyber-cyan text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              <div class="font-body text-body-sm"><strong>Auto-Scaling Clusters:</strong> Respond to load spikes in milliseconds without manual intervention.</div>
            </li>
            <li class="flex items-start gap-3">
              <span class="material-symbols-outlined text-primary dark:text-cyber-cyan text-[20px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
              <div class="font-body text-body-sm"><strong>Edge-Native Delivery:</strong> Minimize latency with localized computing nodes across Europe.</div>
            </li>
          </ul>
          <a href="/contact" class="inline-flex rounded-full border border-outline-variant dark:border-white/[0.12] text-on-surface px-6 py-2.5 font-label text-[12px] tracking-[0.02em] uppercase hover:bg-surface-container dark:hover:bg-white/[0.06] transition-colors">Explore documentation</a>
        </div>
        <div class="w-full md:w-1/2">
          <div class="rounded-xl border border-outline-variant dark:border-white/[0.08] bg-surface-container-low dark:bg-white/[0.03] p-6">
            <p class="font-label text-[10px] tracking-[0.12em] uppercase text-primary/60 dark:text-cyber-cyan/60 mb-3">Case study — Svea Logistics Hub</p>
            <p class="font-body text-[14px] leading-relaxed text-on-surface-variant mb-4">Migrated 3 warehouses off a single on-prem cluster. Automated the parts that kept breaking at 4am. 42% lower ops cost after 6 months.</p>
            <div class="flex gap-4 pt-4 border-t border-outline-variant dark:border-white/[0.06]">
              <div><p class="font-display text-lg font-semibold">42%</p><p class="font-label text-[10px] tracking-[0.08em] uppercase text-on-surface-variant">Cost reduction</p></div>
              <div><p class="font-display text-lg font-semibold">11 days</p><p class="font-label text-[10px] tracking-[0.08em] uppercase text-on-surface-variant">Migration</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 border-t border-outline-variant dark:border-white/[0.08]" id="ai">
      <div class="text-center mb-8">
        <span class="font-label text-[12px] tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan block mb-2">Predictive Intelligence</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em]">AI-Driven Decision Analytics</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-4">
        <div class="md:col-span-2 md:row-span-2 glass-mid rounded-xl p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-headline-md font-semibold mb-3">Advanced Neural Telemetry</h3>
            <p class="font-body text-body-sm text-on-surface-variant mb-6">Our AI models process millions of data points per second to identify patterns invisible to traditional monitoring tools.</p>
          </div>
          <div class="w-full rounded-lg border border-outline-variant dark:border-white/[0.06] bg-surface-container-low dark:bg-white/[0.03] p-4 font-mono text-[11px] leading-5 text-on-surface-variant">
            <p class="text-primary dark:text-cyber-cyan">telemetry.ingest — 2.4M events/s</p>
            <p>p95 latency 11ms → model.predict() → action.dispatch</p>
            <p class="opacity-60 mt-2">No dashboard theater. Just the pipeline that pages you at 3am or doesn't.</p>
          </div>
        </div>
        <div class="md:col-span-2 bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black rounded-xl p-6 flex flex-col justify-center shadow-bloom-soft">
          <h4 class="font-display text-headline-md font-bold mb-1">89% Accuracy</h4>
          <p class="font-body text-body-sm opacity-80">In predictive maintenance forecasting for industrial IoT fleets.</p>
        </div>
        <div class="glass-mid rounded-xl p-4 hover:border-primary dark:hover:border-cyber-cyan/30 transition-all ease-spring">
          <span class="material-symbols-outlined text-primary dark:text-cyber-cyan mb-3">insights</span>
          <h4 class="font-label text-[12px] tracking-[0.02em] uppercase font-semibold mb-1">Real-time Flux</h4>
          <p class="font-body text-body-sm text-on-surface-variant">Live stream analytics with zero window buffering.</p>
        </div>
        <div class="glass-mid rounded-xl p-4 hover:border-primary dark:hover:border-cyber-cyan/30 transition-all ease-spring">
          <span class="material-symbols-outlined text-primary dark:text-cyber-cyan mb-3">hub</span>
          <h4 class="font-label text-[12px] tracking-[0.02em] uppercase font-semibold mb-1">Model Mesh</h4>
          <p class="font-body text-body-sm text-on-surface-variant">Interconnected neural nodes for distributed learning.</p>
        </div>
      </div>
    </section>

    <section class="py-12 border-t border-outline-variant dark:border-white/[0.08] mb-12" id="networking">
      <div class="flex flex-col md:flex-row-reverse gap-8 items-center">
        <div class="w-full md:w-1/2">
          <span class="font-label text-[12px] tracking-[0.02em] uppercase text-primary dark:text-cyber-cyan block mb-2">Secure Core</span>
          <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em] mb-4">Zero-Trust Network Perimeter</h2>
          <p class="font-body text-body-base text-on-surface-variant mb-6 leading-relaxed">
            Security is not a layer; it is the foundation. Visbyr employs end-to-end encrypted tunnels and hardware-level authentication to protect your most sensitive data transfers.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
            <div class="p-4 glass-mid rounded-lg">
              <p class="font-display text-headline-md font-bold text-primary dark:text-cyber-cyan">AES-256</p>
              <p class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Post-Quantum Encryption</p>
            </div>
            <div class="p-4 glass-mid rounded-lg">
              <p class="font-display text-headline-md font-bold text-primary dark:text-cyber-cyan">&lt;1ms</p>
              <p class="font-label text-[12px] tracking-[0.02em] uppercase text-on-surface-variant">Auth Handshake Latency</p>
            </div>
          </div>
          <a href="/contact" class="inline-flex bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-6 py-2.5 rounded-full font-label text-[12px] tracking-[0.02em] uppercase hover:shadow-bloom transition-colors">Download whitepaper</a>
        </div>
        <div class="w-full md:w-1/2">
          <SecurityGraphic client:load />
        </div>
      </div>
    </section>

    <section class="bg-inverse-surface dark:bg-surface-container-lowest text-inverse-on-surface dark:text-mist-text py-12 px-6 text-center rounded-xl border border-white/5">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-[-0.015em] mb-3">Ready to optimize your infrastructure?</h2>
      <p class="font-body text-body-base opacity-80 mb-6 max-w-xl mx-auto">Join the leading Nordic enterprises leveraging Visbyr's technical precision to drive global growth.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center bg-primary dark:bg-cyber-cyan text-on-primary dark:text-obsidian-black px-6 py-3 rounded-full font-label text-[12px] tracking-[0.02em] uppercase hover:shadow-bloom transition-colors">Schedule a consult</a>
        <a href="/solutions" class="inline-flex items-center justify-center border border-white/20 text-white px-6 py-3 rounded-full font-label text-[12px] tracking-[0.02em] uppercase hover:bg-white/10 transition-colors">View all services</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
