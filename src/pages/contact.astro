---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.tsx';
import ArrowUpRight from '../components/ArrowUpRight.astro';
---

<BaseLayout title="Contact | Visbyr" description="Contact Visbyr: Vilhelm Gain and Timothy Wong. Write and one of us answers.">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader
      label="Contact"
      title="Talk to whoever does the work"
      lede="No office, no account managers. Write and one of us answers."
    />

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-12">
          <div class="lg:col-span-7">
            <ContactForm client:load />
          </div>

          <div class="lg:col-span-5 space-y-10">
            <div>
              <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint mb-4">People</p>
              <div class="border-t border-hairline">
                <div class="py-5 border-b border-hairline">
                  <p class="text-[16px] font-semibold tracking-[-0.01em]">Vilhelm Gain</p>
                  <p class="text-[14px] text-muted mt-0.5 mb-2">Founder — product and engineering</p>
                  <a href="https://github.com/VilhelmGain" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[14px] text-accent hover:text-ink transition-colors">
                    github.com/VilhelmGain <ArrowUpRight />
                  </a>
                </div>
                <div class="py-5 border-b border-hairline">
                  <p class="text-[16px] font-semibold tracking-[-0.01em]">Timothy Wong</p>
                  <p class="text-[14px] text-muted mt-0.5 mb-2">Engineer — writes most of the code</p>
                  <a href="https://github.com/timothy0509" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-[14px] text-accent hover:text-ink transition-colors">
                    github.com/timothy0509 <ArrowUpRight />
                  </a>
                </div>
              </div>
            </div>

            <div class="border-t border-hairline pt-6 space-y-3.5">
              <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-faint mb-4">Direct</p>
              <p class="text-[15px]">
                <a class="text-ink hover:text-accent transition-colors" href="mailto:hello@visbyr.com">hello@visbyr.com</a>
              </p>
              <p class="text-[15px] text-muted leading-relaxed">Prefer email? That works too. It reaches both of us.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
