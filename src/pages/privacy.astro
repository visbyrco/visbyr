---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Privacy | Visbyr">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader label="Privacy" title="Privacy policy" lede="Last updated October 2026." />

    <section class="border-t border-hairline">
      <div class="max-w-[42rem] mx-auto px-5 md:px-8 py-14 md:py-20">
        {[
          ['1', 'What we collect', 'If you write to us, we get your name, email address, and whatever you put in the message. Nothing else.'],
          ['2', 'What we do with it', 'We use it to answer you. We do not sell or share your details with anyone.'],
          ['3', 'How long we keep it', 'We keep messages only as long as we need them to handle your request.'],
          ['4', 'Contact', 'Questions about your data? Reach us through the contact page and we will sort it out.'],
        ].map(([n, t, p]) => (
          <div class="py-8 border-b border-hairline first:pt-0">
            <h2 class="text-[19px] font-semibold tracking-[-0.02em] mb-3"><span class="font-mono text-[12px] text-faint mr-3">{n}</span>{t}</h2>
            <p class="text-[15px] leading-relaxed text-muted">{p}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
