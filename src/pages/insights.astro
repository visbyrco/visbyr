---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderReact from '../components/HeaderReact.tsx';
import Footer from '../components/Footer.astro';
import SurgicalAccent from '../components/SurgicalAccent.astro';
---

<BaseLayout title="Insights | Visbyr">
  <HeaderReact client:load />
  <main class="pt-20">
    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-white border-b border-outline-variant/30">
      <div class="max-w-max-width mx-auto">
        <div class="flex items-center gap-md mb-lg">
          <span class="w-2 h-2 rounded-full bg-primary"></span>
          <span class="mono-label text-on-surface-variant">Intelligence Hub</span>
        </div>
        <h1 class="text-[clamp(3.5rem,10vw,6rem)] font-extrabold mb-xl leading-none max-w-4xl">
          Insights & <span class="text-primary">Analysis.</span>
        </h1>
        <p class="text-lg text-on-surface-variant max-w-2xl body-text">
          Strategic whitepapers, market analysis, and technical deep-dives from the Visbyr research division.
        </p>
      </div>
    </section>

    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-white">
      <div class="max-w-max-width mx-auto">
        <div class="flex flex-col lg:flex-row justify-between items-end mb-xxl gap-lg">
          <div class="max-w-2xl">
            <SurgicalAccent />
            <h2 class="text-5xl font-bold mb-lg mt-lg">Latest Publications</h2>
            <p class="text-xl text-on-surface-variant body-text">Curated intelligence for enterprise decision-makers navigating the Nordic technology landscape.</p>
          </div>
          <div class="mono-label text-primary font-bold">[ 01 — Repository ]</div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-xl border-t border-outline-variant/30 pt-xl">
          <article class="group p-xl border border-outline-variant/30 hover:bg-surface-container-low transition-colors duration-500">
            <div class="flex items-center gap-md mb-lg">
              <span class="mono-label text-primary bg-primary-fixed px-3 py-1">Cloud</span>
              <span class="mono-label text-on-surface-variant">2024.11</span>
            </div>
            <h3 class="text-2xl font-bold mb-md group-hover:text-primary transition-colors">Nordic Data Sovereignty in a Post-GDPR Era</h3>
            <p class="body-text text-on-surface-variant mb-lg">An analysis of evolving data residency requirements and how Nordic enterprises are architecting compliant cloud infrastructure.</p>
            <div class="flex items-center gap-sm mono-label font-bold text-primary">
              Read Analysis <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </div>
          </article>

          <article class="group p-xl border border-outline-variant/30 hover:bg-surface-container-low transition-colors duration-500">
            <div class="flex items-center gap-md mb-lg">
              <span class="mono-label text-primary bg-primary-fixed px-3 py-1">AI</span>
              <span class="mono-label text-on-surface-variant">2024.10</span>
            </div>
            <h3 class="text-2xl font-bold mb-md group-hover:text-primary transition-colors">Predictive Maintenance: Industrial IoT at Scale</h3>
            <p class="body-text text-on-surface-variant mb-lg">How machine learning models achieve 89% accuracy in forecasting equipment failures across distributed manufacturing fleets.</p>
            <div class="flex items-center gap-sm mono-label font-bold text-primary">
              Read Analysis <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </div>
          </article>

          <article class="group p-xl border border-outline-variant/30 hover:bg-surface-container-low transition-colors duration-500">
            <div class="flex items-center gap-md mb-lg">
              <span class="mono-label text-primary bg-primary-fixed px-3 py-1">Security</span>
              <span class="mono-label text-on-surface-variant">2024.09</span>
            </div>
            <h3 class="text-2xl font-bold mb-md group-hover:text-primary transition-colors">Zero-Trust Architecture for Distributed Enterprises</h3>
            <p class="body-text text-on-surface-variant mb-xl">A technical whitepaper on implementing hardware-level authentication and end-to-end encrypted tunnels across organizational boundaries.</p>
            <div class="flex items-center gap-sm mono-label font-bold text-primary">
              Read Analysis <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </div>
          </article>

          <article class="group p-xl border border-outline-variant/30 hover:bg-surface-container-low transition-colors duration-500">
            <div class="flex items-center gap-md mb-lg">
              <span class="mono-label text-primary bg-primary-fixed px-3 py-1">Strategy</span>
              <span class="mono-label text-on-surface-variant">2024.08</span>
            </div>
            <h3 class="text-2xl font-bold mb-md group-hover:text-primary transition-colors">The Case for Nordic Functionalism in Software Design</h3>
            <p class="body-text text-on-surface-variant mb-xl">Why the principles of Scandinavian design — restraint, purpose, and clarity — produce more resilient and maintainable software systems.</p>
            <div class="flex items-center gap-sm mono-label font-bold text-primary">
              Read Analysis <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="py-xxl px-margin-mobile md:px-margin-desktop bg-on-surface text-white border-y border-outline-variant/30">
      <div class="max-w-max-width mx-auto text-center">
        <h2 class="text-5xl font-bold mb-lg">Stay Informed</h2>
        <p class="text-body-md opacity-80 mb-xl max-w-xl mx-auto">Receive strategic insights and technical analysis directly from our Stockholm research division.</p>
        <div class="flex flex-col sm:flex-row gap-md justify-center">
          <a href="/contact" class="bg-primary text-on-primary px-xl py-md mono-label hover:opacity-90 transition-all inline-block text-center">Subscribe to Insights</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
