---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHeader from '../components/PageHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ArrowRight from '../components/ArrowRight.astro';
---

<BaseLayout title="Notes | Visbyr" description="Writing from the Visbyr studio: data sovereignty, predictive maintenance, zero-trust architecture, and Nordic functionalism.">
  <SiteHeader />
  <main class="pt-16">
    <PageHeader
      n="07"
      label="Notes"
      title="Notes from the studio"
      lede="What we are reading, testing, and arguing about. Short, technical, and written by the engineers doing the work."
    />

    <section class="border-b border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <Eyebrow label="Writing" />
        <div class="border-t border-hairline mt-8">
          {[
            { date: '2024.11', title: 'Data sovereignty after GDPR', desc: 'What evolving residency requirements actually ask of cloud architecture, and what we build to satisfy them.' },
            { date: '2024.10', title: 'Predictive maintenance at scale', desc: 'How a failure-prediction model reaches 89% accuracy on an industrial fleet — and what it needs before it gets there.' },
            { date: '2024.09', title: 'Zero-trust for distributed teams', desc: 'Hardware-key authentication and encrypted tunnels across organizational boundaries, in practice.' },
            { date: '2024.08', title: 'Functionalism in software design', desc: 'Why restraint, purpose, and clarity produce more resilient systems. The case for building less.' },
          ].map((p) => (
            <article class="group grid grid-cols-[auto_1fr_auto] md:grid-cols-[7rem_1fr_auto] gap-4 md:gap-8 items-baseline py-6 border-b border-hairline">
              <span class="font-mono text-[12px] tracking-[0.04em] text-faint">{p.date}</span>
              <div>
                <h2 class="text-[19px] font-semibold tracking-[-0.02em] group-hover:text-accent transition-colors">{p.title}</h2>
                <p class="text-[15px] leading-relaxed text-muted mt-1.5 max-w-[40rem]">{p.desc}</p>
              </div>
              <a href="/contact" class="inline-flex items-center gap-2 text-[14px] text-accent shrink-0" aria-label={`Request a copy: ${p.title}`}>
                <span class="hidden sm:inline">Copy</span> <ArrowRight class="transition-transform group-hover:translate-x-0.5" />
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-hairline">
      <div class="max-w-page mx-auto px-5 md:px-8 py-14 md:py-20">
        <div class="max-w-[34rem]">
          <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.03em]">Get the next one first</h2>
          <p class="mt-4 text-[16px] leading-relaxed text-muted">Write to us and we will add you to the list. A few notes a year, no newsletter theater.</p>
          <a href="mailto:hello@visbyr.com?subject=Notes%20list" class="inline-flex items-center gap-2 mt-6 bg-accent text-on-accent px-6 py-3 text-[13px] font-medium rounded-[3px] hover:bg-accent-strong transition-colors">
            Subscribe by email
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
